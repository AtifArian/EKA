# Email Configuration for 2FA (Gmail)
# IMPORTANT: For Gmail, you need to use an "App Password" not your regular password
# To generate an App Password:
# 1. Go to your Google Account settings
# 2. Enable 2-Step Verification if not already enabled
# 3. Go to Security > 2-Step Verification > App passwords
# 4. Generate a new app password for "Mail" app
# 5. Use that 16-character password below
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Testing mode - set to true to include OTP in API response (for development only)
TESTING_MODE=true
FLASK_ENV=development