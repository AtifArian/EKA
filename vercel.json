{
  "version": 2,
  "name": "eka-frontend",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "frontend/build" }
    }
  ],
  "env": {
    "REACT_APP_API_URL": "https://YOUR-BACKEND-URL/api"
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://YOUR-BACKEND-URL/api/$1"
    }
  ]
}